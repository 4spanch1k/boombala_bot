{
  "name": "boombala-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "eval": "tsx --env-file=.env evals/run.ts",
    "chat": "tsx --env-file=.env src/cli.ts",
