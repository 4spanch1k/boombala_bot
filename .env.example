# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
VERIFY_TOKEN=придумайте-любую-строку
APP_SECRET=

# Опционально: уведомления менеджеру в Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

PORT=3000

# Безопасный запуск на боевом номере
# off | allowlist | shadow | live   (по умолчанию allowlist)
BOT_MODE=allowlist
# Номера (цифры, через запятую), которым бот отвечает в режиме allowlist
BOT_ALLOWLIST=
MAX_REPLIES_PER_HOUR=6
MANAGER_COOLDOWN_HOURS=12
