# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
VERIFY_TOKEN=придумайте-любую-строку
APP_SECRET=

# Опционально: уведомления менеджеру в Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

PORT=3000

# Безопасный запуск на боевом номере
# off | allowlist | shadow | live   (по умолчанию allowlist)
BOT_MODE=allowlist
# Номера (цифры, через запятую), которым бот отвечает в режиме allowlist
BOT_ALLOWLIST=
MAX_REPLIES_PER_HOUR=30
MANAGER_COOLDOWN_HOURS=12

# Telegram-бот (тест-драйв). Токен берётся у @BotFather.
# TELEGRAM_CHAT_ID — чат/группа менеджеров, куда приходят заявки и передачи (узнать: написать боту /id).
# TELEGRAM_MODE: off | allowlist | shadow | live (по умолчанию live)
TELEGRAM_MODE=live
# 0 = без лимита (по умолчанию для Telegram)
TELEGRAM_MAX_REPLIES_PER_HOUR=0

# Предоплата. Пока PAYMENT_REQUISITES пуст, бот не берёт оплату: слот закрепляется, дальше менеджер.
# Сумма: фиксированная (PREPAYMENT_FIXED, тенге) или процент от расчёта (PREPAYMENT_PERCENT).
PAYMENT_REQUISITES=
PREPAYMENT_FIXED=
PREPAYMENT_PERCENT=
# Сколько часов слот держится за клиентом до оплаты
HOLD_HOURS=24
# Проверка поступления: manual (проверяет менеджер, npm run paid) или будущий банковский провайдер
PAYMENT_PROVIDER=manual
